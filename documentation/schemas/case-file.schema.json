{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neko-top:schema:case-file",
  "title": "Neko-TOP case file",
  "description": "Neko's case file plus the keys of the Neko-TOP drivers. Everything Neko's own schema accepts outside Neko-TOP's keys stays accepted.",
  "allOf": [
    {
      "$ref": "urn:neko:schema:case-file"
    },
    {
      "type": "object",
      "properties": {
        "case": {
          "$ref": "#/$defs/case"
        },
        "optimization": {
          "$ref": "urn:neko-top:schema:optimization#/$defs/optimization"
        },
        "unsteady": {
          "description": "Run the optimisation with an unsteady forward and adjoint solve. Default false. Read by the topology optimisation drivers only (sources/simulation/simulation.f90:271).",
          "type": "boolean"
        },
        "state_recovery": {
          "description": "How the forward state is recovered for the adjoint; read, and required, only when `unsteady` is true.",
          "$ref": "urn:neko-top:schema:state-recovery#/$defs/stateRecovery"
        },
        "norm_scaling": {
          "description": "Left over from the power iteration, which has no caller; read at the document root. Default 0.5. Read only by the topology optimisation drivers (adjoint_fluid_pnpn.f90:469-492); typed under `optimization`."
        },
        "norm_target": {
          "description": "As `norm_scaling`. Default -1.0. Read only by the topology optimisation drivers (adjoint_fluid_pnpn.f90:469-492); typed under `optimization`."
        },
        "norm_tolerance": {
          "description": "As `norm_scaling`. Default 10.0. Read only by the topology optimisation drivers (adjoint_fluid_pnpn.f90:469-492); typed under `optimization`."
        },
        "output_file": {
          "description": "Left over from the power iteration; read at the document root by the topology optimisation drivers only (adjoint_fluid_pnpn.f90:469-492), where it must end in a file suffix Neko knows. Default `power_iterations.csv`."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "optimization"
            ]
          },
          "then": {
            "$ref": "#/$defs/optimizing"
          }
        }
      ]
    }
  ],
  "$defs": {
    "case": {
      "description": "Neko-TOP additions to Neko's open `case` object.",
      "type": "object",
      "properties": {
        "fluid": {
          "$ref": "urn:neko-top:schema:fluid#/$defs/fluidAdditions"
        },
        "scalar": {
          "$ref": "urn:neko-top:schema:scalar#/$defs/scalarAdditions"
        },
        "scalars": {
          "type": "array",
          "items": {
            "$ref": "urn:neko-top:schema:scalar#/$defs/scalarAdditions"
          }
        },
        "adjoint_fluid": {
          "$ref": "urn:neko-top:schema:adjoint-fluid#/$defs/adjointFluid"
        },
        "adjoint_scalar": {
          "$ref": "urn:neko-top:schema:adjoint-scalar#/$defs/adjointScalar"
        },
        "simulation_components": {
          "type": "array",
          "items": {
            "$ref": "urn:neko-top:schema:simulation-components#/$defs/simulationComponentAdditions"
          }
        }
      },
      "allOf": [
        {
          "$comment": "steady_simcomp.f90:148-151 aborts when a steady component meets more than one scalar. The component is registered by every driver (neko_top_register_types), so the rule holds without `optimization` too. It counts the entries of case.scalars; the code counts the enabled ones, so the rare [enabled, disabled] form is rejected too (the whitelisted keywords have no `contains`). With case.scalar present Neko builds that one and never reads case.scalars (neko src/case.f90:319-353), so the rule does not apply then. An entry with is_user true is skipped by Neko's factory (simulation_component_fctry.f90:108-109), so it is not counted.",
          "if": {
            "allOf": [
              {
                "required": [
                  "simulation_components"
                ],
                "properties": {
                  "simulation_components": {
                    "not": {
                      "items": {
                        "not": {
                          "required": [
                            "type"
                          ],
                          "properties": {
                            "type": {
                              "const": "steady"
                            }
                          },
                          "not": {
                            "required": [
                              "is_user"
                            ],
                            "properties": {
                              "is_user": {
                                "const": true
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "not": {
                  "required": [
                    "scalar"
                  ]
                }
              }
            ]
          },
          "then": {
            "properties": {
              "scalars": {
                "maxItems": 1
              }
            }
          }
        }
      ]
    },
    "optimizing": {
      "description": "Restrictions that apply when the case has an `optimization` object, that is when a topology optimisation driver runs it.",
      "allOf": [
        {
          "properties": {
            "case": {
              "allOf": [
                {
                  "$comment": "neko_ext.f90:356-359 (reset_adjoint) reads case.adjoint_fluid.initial_condition at every design iteration with no fallback. adjoint_case.f90:453-460 reads output_value for the output controls that need it (and the adjoint fluid is built by the topology optimisation drivers only).",
                  "required": [
                    "adjoint_fluid"
                  ],
                  "properties": {
                    "adjoint_fluid": {
                      "required": [
                        "initial_condition"
                      ],
                      "allOf": [
                        {
                          "if": {
                            "required": [
                              "output_control"
                            ],
                            "properties": {
                              "output_control": {
                                "enum": [
                                  "tsteps",
                                  "nsamples",
                                  "simulationtime"
                                ]
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "output_value"
                            ]
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "properties": {
                    "fluid": {
                      "$ref": "urn:neko-top:schema:fluid#/$defs/fluidOptimizing"
                    },
                    "numerics": {
                      "$comment": "A true `oifs` aborts (advection_adjoint_fctry.f90:106, adjoint_fluid_pnpn.f90:742). The orders (adjoint_fluid_pnpn.f90:310, adjoint_case.f90:136, advection_adjoint_fctry.f90:98-101) go through the constants lookup, like Neko's own, so Neko's definitions apply.",
                      "properties": {
                        "oifs": {
                          "const": false
                        }
                      }
                    }
                  }
                },
                {
                  "$comment": "adjoint_case.f90:253-254 aborts after the whole initialisation when only case.adjoint_scalars is given and has entries.",
                  "if": {
                    "not": {
                      "required": [
                        "adjoint_scalar"
                      ]
                    }
                  },
                  "then": {
                    "properties": {
                      "adjoint_scalars": {
                        "type": "array",
                        "maxItems": 0
                      }
                    }
                  }
                },
                {
                  "$comment": "adjoint_case.f90:181-184: without case.adjoint_scalar, case.adjoint_scalars takes the array branch, which calls params%info('case.scalars', n_children=...) without `found`. On a missing path json-fortran is left in an exception state, every later lookup fails and the next read, json_get('case.time') at :261, aborts with 'Parameter case.time missing from the case file' (also for an empty case.adjoint_scalars).",
                  "if": {
                    "required": [
                      "adjoint_scalars"
                    ],
                    "not": {
                      "required": [
                        "adjoint_scalar"
                      ]
                    }
                  },
                  "then": {
                    "required": [
                      "scalars"
                    ]
                  }
                },
                {
                  "$comment": "neko_ext.f90:236-238 and :399-423 reset the scalar and its adjoint at every design iteration; with an enabled scalar but no enabled adjoint scalar reset_adjoint dereferences an unallocated array (neko_ext.f90:404).",
                  "if": {
                    "required": [
                      "scalar"
                    ],
                    "properties": {
                      "scalar": {
                        "not": {
                          "required": [
                            "enabled"
                          ],
                          "properties": {
                            "enabled": {
                              "const": false
                            }
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "allOf": [
                      {
                        "properties": {
                          "scalar": {
                            "$ref": "urn:neko-top:schema:scalar#/$defs/scalarForward"
                          }
                        }
                      },
                      {
                        "required": [
                          "adjoint_scalar"
                        ],
                        "properties": {
                          "adjoint_scalar": {
                            "not": {
                              "required": [
                                "enabled"
                              ],
                              "properties": {
                                "enabled": {
                                  "const": false
                                }
                              }
                            }
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "$comment": "adjoint_case.f90:205 needs case.scalar; adjoint_scalar_scheme.f90:342 needs it enabled.",
                  "if": {
                    "required": [
                      "adjoint_scalar"
                    ],
                    "properties": {
                      "adjoint_scalar": {
                        "not": {
                          "required": [
                            "enabled"
                          ],
                          "properties": {
                            "enabled": {
                              "const": false
                            }
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "allOf": [
                      {
                        "required": [
                          "scalar"
                        ],
                        "properties": {
                          "scalar": {
                            "not": {
                              "required": [
                                "enabled"
                              ],
                              "properties": {
                                "enabled": {
                                  "const": false
                                }
                              }
                            }
                          }
                        }
                      },
                      {
                        "properties": {
                          "scalar": {
                            "$ref": "urn:neko-top:schema:scalar#/$defs/scalarOptimizing"
                          }
                        }
                      },
                      {
                        "$comment": "adjoint_case.f90:310-313 and neko_ext.f90:420-423 read initial_condition.type of an enabled adjoint scalar without a default; nothing reads case.adjoint_scalar without `optimization`.",
                        "properties": {
                          "adjoint_scalar": {
                            "$ref": "urn:neko:schema:scalar#/$defs/scalarInitialConditionRequired"
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "$comment": "adjoint_scalar_scheme.f90:282 reads primal_name (default s) and looks the field up by it (:342); the field is named case.scalar.name (Neko default s). That the two names are equal cannot be expressed; the cases that cannot match are rejected. The adjoint scalar must be enabled (adjoint_case.f90:176-197); a disabled one never reads primal_name.",
                  "if": {
                    "required": [
                      "scalar",
                      "adjoint_scalar"
                    ],
                    "properties": {
                      "scalar": {
                        "required": [
                          "name"
                        ],
                        "properties": {
                          "name": {
                            "not": {
                              "const": "s"
                            }
                          }
                        }
                      },
                      "adjoint_scalar": {
                        "not": {
                          "required": [
                            "enabled"
                          ],
                          "properties": {
                            "enabled": {
                              "const": false
                            }
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "adjoint_scalar": {
                        "required": [
                          "primal_name"
                        ],
                        "properties": {
                          "primal_name": {
                            "not": {
                              "const": "s"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "$comment": "Same lookup: with the scalar named s (explicitly or by default) primal_name can only be s. Again only for an enabled adjoint scalar.",
                  "if": {
                    "required": [
                      "adjoint_scalar"
                    ],
                    "properties": {
                      "scalar": {
                        "not": {
                          "required": [
                            "name"
                          ],
                          "properties": {
                            "name": {
                              "not": {
                                "const": "s"
                              }
                            }
                          }
                        }
                      },
                      "adjoint_scalar": {
                        "not": {
                          "required": [
                            "enabled"
                          ],
                          "properties": {
                            "enabled": {
                              "const": false
                            }
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "adjoint_scalar": {
                        "properties": {
                          "primal_name": {
                            "const": "s"
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "$comment": "adjoint_case.f90:444-446 reads case.nsamples for output_control `org` with no default (neko src/common/case_file_utils.f90:129-142, json_utils.f90:252). Neko has the same rule for case.fluid.output_control.",
                  "if": {
                    "required": [
                      "adjoint_fluid"
                    ],
                    "properties": {
                      "adjoint_fluid": {
                        "required": [
                          "output_control"
                        ],
                        "properties": {
                          "output_control": {
                            "const": "org"
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "nsamples"
                    ]
                  }
                },
                {
                  "$comment": "adjoint_scalar_pnpn.f90:216,218,264-268: the scheme's own fields abx1 and abx2 are added to the checkpoint payload registered under the adjoint name, and neko src/common/checkpoint_payload.f90:607-611 aborts on a duplicate field name. A name that is another field of the registry (u, p, u_adj, the design fields, ...) only makes the adjoint reuse that field (adjoint_scalar_scheme.f90:334-338) and does not abort.",
                  "if": {
                    "required": [
                      "adjoint_scalar"
                    ],
                    "properties": {
                      "adjoint_scalar": {
                        "not": {
                          "required": [
                            "enabled"
                          ],
                          "properties": {
                            "enabled": {
                              "const": false
                            }
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "adjoint_scalar": {
                        "properties": {
                          "name": {
                            "not": {
                              "enum": [
                                "abx1",
                                "abx2"
                              ]
                            }
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "$comment": "The adjoint velocity, pressure and scalar solvers build Neko's preconditioner through precon_factory (adjoint_fluid_scheme_incompressible.f90:322-330,349-351; adjoint_scalar_scheme.f90:293-300,389-391), and hsmg aborts for polynomial order 1 (neko src/krylov/pc_hsmg.f90:224-225). Neko's own rule covers the primal solvers (urn:neko:schema:case-file#/$defs/case/allOf/7).",
                  "if": {
                    "required": [
                      "numerics"
                    ],
                    "properties": {
                      "numerics": {
                        "required": [
                          "polynomial_order"
                        ],
                        "properties": {
                          "polynomial_order": {
                            "const": 1
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "adjoint_fluid": {
                        "properties": {
                          "velocity_solver": {
                            "$ref": "urn:neko:schema:case-file#/$defs/notHsmgSolver"
                          }
                        }
                      },
                      "adjoint_scalar": {
                        "properties": {
                          "solver": {
                            "$ref": "urn:neko:schema:case-file#/$defs/notHsmgSolver"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        {
          "$comment": "brinkman_dissipation_objective.f90:151-163: both flags default to case.numerics.dealias and must end up equal, so a single flag must equal it.",
          "if": {
            "required": [
              "case"
            ],
            "properties": {
              "case": {
                "required": [
                  "numerics"
                ],
                "properties": {
                  "numerics": {
                    "required": [
                      "dealias"
                    ],
                    "properties": {
                      "dealias": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "optimization": {
                "properties": {
                  "objectives": {
                    "items": {
                      "if": {
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "brinkman_dissipation"
                          }
                        }
                      },
                      "then": {
                        "anyOf": [
                          {
                            "required": [
                              "dealias_sensitivity",
                              "dealias_forcing"
                            ]
                          },
                          {
                            "properties": {
                              "dealias_sensitivity": {
                                "const": true
                              },
                              "dealias_forcing": {
                                "const": true
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "brinkman_dissipation_objective.f90:151-163: both flags default to case.numerics.dealias and must end up equal, so a single flag must equal it.",
          "if": {
            "required": [
              "case"
            ],
            "properties": {
              "case": {
                "required": [
                  "numerics"
                ],
                "properties": {
                  "numerics": {
                    "required": [
                      "dealias"
                    ],
                    "properties": {
                      "dealias": {
                        "const": false
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "optimization": {
                "properties": {
                  "objectives": {
                    "items": {
                      "if": {
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "brinkman_dissipation"
                          }
                        }
                      },
                      "then": {
                        "anyOf": [
                          {
                            "required": [
                              "dealias_sensitivity",
                              "dealias_forcing"
                            ]
                          },
                          {
                            "properties": {
                              "dealias_sensitivity": {
                                "const": false
                              },
                              "dealias_forcing": {
                                "const": false
                              }
                            }
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "scalar_mixing_objective_function.f90:172 aborts without an enabled adjoint scalar.",
          "if": {
            "required": [
              "optimization"
            ],
            "properties": {
              "optimization": {
                "required": [
                  "objectives"
                ],
                "properties": {
                  "objectives": {
                    "not": {
                      "items": {
                        "not": {
                          "required": [
                            "type"
                          ],
                          "properties": {
                            "type": {
                              "const": "scalar_mixing"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "case": {
                "allOf": [
                  {
                    "required": [
                      "adjoint_scalar"
                    ],
                    "properties": {
                      "adjoint_scalar": {
                        "not": {
                          "required": [
                            "enabled"
                          ],
                          "properties": {
                            "enabled": {
                              "const": false
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "$comment": "simulation.f90:283 aborts for an unsteady run with case.time.variable_timestep true.",
          "if": {
            "required": [
              "unsteady"
            ],
            "properties": {
              "unsteady": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "case": {
                "properties": {
                  "time": {
                    "properties": {
                      "variable_timestep": {
                        "const": false
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "Owner ruling 2026-11-16: a `steady` simulation component with `unsteady: true` is invalid. The rejection exists in the code only on an unmerged branch; steady_simcomp.f90:116-133 does not reject it yet. An entry with is_user true is skipped by Neko's factory before `type` is read (neko src/simulation_components/simulation_component_fctry.f90:108-109), so no steady component is built and the ruling does not apply to it (the overlay in simulation-components.schema.json exempts it too).",
          "if": {
            "required": [
              "unsteady"
            ],
            "properties": {
              "unsteady": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "case": {
                "properties": {
                  "simulation_components": {
                    "items": {
                      "not": {
                        "required": [
                          "type"
                        ],
                        "properties": {
                          "type": {
                            "const": "steady"
                          }
                        },
                        "not": {
                          "required": [
                            "is_user"
                          ],
                          "properties": {
                            "is_user": {
                              "const": true
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "simulation.f90:271-301: `unsteady` is read at :271 and, for an unsteady run, state_recovery at :299 (factory :300-301); state_recovery is required for an unsteady run and not read otherwise. :283 aborts a variable timestep and :289-297 abort case.time.exact_output_time true. Read by the topology optimisation drivers only.",
          "if": {
            "required": [
              "unsteady"
            ],
            "properties": {
              "unsteady": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "state_recovery"
            ],
            "properties": {
              "case": {
                "properties": {
                  "time": {
                    "properties": {
                      "exact_output_time": {
                        "const": false
                      }
                    }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "state_recovery": false
            }
          }
        },
        {
          "$comment": "adjoint_fluid_pnpn.f90:469-492 reads these root keys (the power iteration leftovers) as reals through the constants lookup, and output_file with a file suffix that neko src/io/file.f90:133 knows. Without `optimization` nothing reads them.",
          "properties": {
            "norm_scaling": {
              "$ref": "urn:neko:schema:common#/$defs/numberOrRef"
            },
            "norm_target": {
              "$ref": "urn:neko:schema:common#/$defs/numberOrRef"
            },
            "norm_tolerance": {
              "$ref": "urn:neko:schema:common#/$defs/numberOrRef"
            },
            "output_file": {
              "type": "string",
              "pattern": "\\.(rea|re2|map|vtk|nmsh|bp|fld|chkp|stl|csv|hdf5|h5|vtkhdf)$"
            }
          }
        },
        {
          "$comment": "The time-window test driver (tests/unit/objectives/time_window_tester.f90:128,137) aborts for a steady run and for an empty objective list. It also aborts for `pairwise: true` with an odd number of objectives (time_window_tester.f90:251-254), which the whitelisted keywords cannot express (no array-length parity).",
          "if": {
            "required": [
              "optimization"
            ],
            "properties": {
              "optimization": {
                "required": [
                  "time_window_test"
                ]
              }
            }
          },
          "then": {
            "required": [
              "unsteady"
            ],
            "properties": {
              "unsteady": {
                "const": true
              },
              "optimization": {
                "required": [
                  "objectives"
                ],
                "properties": {
                  "objectives": {
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        {
          "$comment": "time_window_tester.f90:199-202 aborts after the first run unless the fluid is frozen, and the only writers of fluid%freeze are the reset from case.fluid.freeze_flow (neko_ext.f90:267-270) and the steady simcomp (steady_simcomp.f90:283), which the schema does not allow in an unsteady run.",
          "if": {
            "required": [
              "optimization"
            ],
            "properties": {
              "optimization": {
                "required": [
                  "time_window_test"
                ],
                "properties": {

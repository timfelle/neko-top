{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neko-top:schema:optimizer",
  "$defs": {
    "mmaSolver": {
      "description": "Method of moving asymptotes.",
      "$comment": "sources/optimizer/mma_optimizer.f90:131-136, sources/mma/mma.f90:281-302",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "mma"
        },
        "tolerance": {
          "description": "Convergence tolerance. Default 1.0e-3.",
          "$ref": "urn:neko:schema:common#/$defs/realNumber"
        },
        "mma": {
          "type": "object",
          "properties": {
            "epsimin": {
              "description": "Minimum subproblem tolerance; positive. Default 1.0e-9 * sqrt(m + n).",
              "$ref": "urn:neko:schema:common#/$defs/positiveRealNumber"
            },
            "max_iter": {
              "description": "Subsolver iterations. Default 100.",
              "type": "integer"
            },
            "asyinit": {
              "description": "Initial asymptote distance. Default 0.2.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "asyincr": {
              "description": "Asymptote increase factor. Default 1.05.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "asydecr": {
              "description": "Asymptote decrease factor. Default 0.65.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "backend": {
              "description": "`cpu` or `device`. Default `device` in a device build, `cpu` otherwise.",
              "$comment": "mma.f90:496 aborts for other values; `device` aborts in a build without a device backend (device_mma_math.f90:755).",
              "enum": [
                "cpu",
                "device"
              ]
            },
            "subsolver": {
              "description": "`dip` or `pdip`. Default `dip`.",
              "$comment": "mma_cpu.f90:122 aborts for other values",
              "enum": [
                "dip",
                "pdip"
              ]
            },
            "xmin": {
              "description": "Lower design bound. Default 0.0.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "xmax": {
              "description": "Upper design bound. Default 1.0.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "a0": {
              "description": "MMA constant a0. Default 1.0.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "a": {
              "description": "MMA constant a. Default 0.0.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "c": {
              "description": "MMA constant c. Default 1000.0.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "d": {
              "description": "MMA constant d. Default 0.0.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "move_limit": {
              "description": "Move limit. Default 0.2.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "scale": {
              "description": "Scaling of the constraints. Default 1.0.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "auto_scale": {
              "description": "Scale by the first constraint value. Default false.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "max_iterations": {
          "description": "Optimiser iterations; 0 evaluates only the initial design. Default 100.",
          "type": "integer"
        },
        "enable_output": {
          "description": "Write optimiser output. Default true.",
          "type": "boolean"
        },
        "max_runtime": {
          "description": "Wall-clock limit as `S`, `M:S`, `H:M:S` or `D-H:M:S`; empty disables it. Default empty.",
          "$comment": "read_duration aborts for other forms (optimizer.f90:429); the pattern is the one of Neko's `job_timelimit`, which uses the same parser.",
          "type": "string",
          "pattern": "^$|^(?:[0-9]+(?:\\.[0-9]+)?|[0-9]+:[0-5]?[0-9](?:\\.[0-9]+)?|[0-9]+:[0-5]?[0-9]:[0-5]?[0-9](?:\\.[0-9]+)?|[0-9]+-(?:[01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9](?:\\.[0-9]+)?)$"
        },
        "stop_design_change": {
          "description": "Stop when the design change falls below this. Default machine epsilon.",
          "$ref": "urn:neko:schema:common#/$defs/realNumber"
        },
        "restart_file": {
          "description": "Optimiser checkpoint to restart from; the file must exist and end in `h5`, `hdf5` or `hf5`. Default none.",
          "$comment": "optimizer.f90:1000-1012",
          "type": "string",
          "pattern": "^$|\\.(h5|hdf5|hf5)$"
        },
        "checkpoint": {
          "description": "Optimiser checkpointing.",
          "type": "object",
          "properties": {
            "path": {
              "description": "Directory. Default `./checkpoints/`.",
              "type": "string"
            },
            "base": {
              "description": "File name base. Default `optimizer_checkpoint`.",
              "type": "string"
            },
            "format": {
              "description": "`h5`, `hdf5`, `hf5` or `hdf`. Default `hdf5`.",
              "$comment": "optimizer.f90:851",
              "enum": [
                "h5",
                "hdf5",
                "hf5",
                "hdf"
              ]
            },
            "interval": {
              "description": "Iterations between checkpoints; values <= 0 disable them. Default -1.",
              "type": "integer"
            },
            "overwrite": {
              "description": "Overwrite an existing checkpoint file (otherwise the run aborts). Default false.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "continuation_iterations": {
          "description": "Default iterations per step of every continuation array. Default 1.",
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "steepestDescentSolver": {
      "description": "Steepest descent. It cannot handle constraints.",
      "$comment": "sources/optimizer/steepest_descent_optimizer.f90:179-242. `tolerance` is read for mma only (mma_optimizer.f90:134). Constraints are rejected in the optimisation schema.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "steepest_descent"
        },
        "steepest_descent": {
          "type": "object",
          "properties": {
            "xmin": {
              "description": "Lower design bound. Default 0.0.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "xmax": {
              "description": "Upper design bound; must exceed xmin (abort at steepest_descent_optimizer.f90:215). Default 1.0.",
              "$ref": "urn:neko:schema:common#/$defs/realNumber"
            },
            "step_length": {
              "description": "Step length; positive. Default 1.0.",
              "$ref": "urn:neko:schema:common#/$defs/positiveRealNumber"
            },
            "move_limit": {
              "description": "Adaptive move limit.",
              "type": "object",
              "properties": {
                "initial": {
                  "description": "Initial move limit; not below `min`. Default 0.1.",
                  "$ref": "urn:neko:schema:common#/$defs/realNumber"
                },
                "min": {
                  "description": "Smallest move limit; positive. Default 0.001.",
                  "$ref": "urn:neko:schema:common#/$defs/positiveRealNumber"
                },
                "max": {
                  "description": "Largest move limit; not below `initial`. Default 0.1.",
                  "$ref": "urn:neko:schema:common#/$defs/realNumber"
                },
                "decrease": {
                  "description": "Decrease factor, in (0, 1]. Default 0.7.",
                  "type": "number",
                  "x-neko-real": true,
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "increase": {
                  "description": "Increase factor, at least 1. Default 1.1.",
                  "type": "number",
                  "x-neko-real": true,
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "max_iterations": {
          "description": "Optimiser iterations; 0 evaluates only the initial design. Default 100.",
          "type": "integer"
        },
        "enable_output": {
          "description": "Write optimiser output. Default true.",
          "type": "boolean"
        },
        "max_runtime": {
          "description": "Wall-clock limit as `S`, `M:S`, `H:M:S` or `D-H:M:S`; empty disables it. Default empty.",
          "$comment": "read_duration aborts for other forms (optimizer.f90:429); the pattern is the one of Neko's `job_timelimit`, which uses the same parser.",
          "type": "string",
          "pattern": "^$|^(?:[0-9]+(?:\\.[0-9]+)?|[0-9]+:[0-5]?[0-9](?:\\.[0-9]+)?|[0-9]+:[0-5]?[0-9]:[0-5]?[0-9](?:\\.[0-9]+)?|[0-9]+-(?:[01]?[0-9]|2[0-3]):[0-5]?[0-9]:[0-5]?[0-9](?:\\.[0-9]+)?)$"
        },
        "stop_design_change": {
          "description": "Stop when the design change falls below this. Default machine epsilon.",
          "$ref": "urn:neko:schema:common#/$defs/realNumber"
        },
        "restart_file": {
          "description": "Optimiser checkpoint to restart from; the file must exist and end in `h5`, `hdf5` or `hf5`. Default none.",
          "$comment": "optimizer.f90:1000-1012",
          "type": "string",
          "pattern": "^$|\\.(h5|hdf5|hf5)$"
        },
        "checkpoint": {
          "description": "Optimiser checkpointing.",
          "type": "object",
          "properties": {
            "path": {
              "description": "Directory. Default `./checkpoints/`.",
              "type": "string"
            },
            "base": {
              "description": "File name base. Default `optimizer_checkpoint`.",
              "type": "string"
            },
            "format": {
              "description": "`h5`, `hdf5`, `hf5` or `hdf`. Default `hdf5`.",
              "$comment": "optimizer.f90:851",
              "enum": [
                "h5",
                "hdf5",
                "hf5",
                "hdf"
              ]
            },
            "interval": {
              "description": "Iterations between checkpoints; values <= 0 disable them. Default -1.",
              "type": "integer"
            },
            "overwrite": {
              "description": "Overwrite an existing checkpoint file (otherwise the run aborts). Default false.",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "continuation_iterations": {
          "description": "Default iterations per step of every continuation array. Default 1.",
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "solver": {
      "description": "`optimization.solver`, discriminated by `type`.",
      "$comment": "Factory: sources/optimizer/optimizer_factory.f90:79-88 (no fallback).",
      "oneOf": [
        {
          "$ref": "#/$defs/mmaSolver"
        },
        {
          "$ref": "#/$defs/steepestDescentSolver"
        }
      ]
    }
  }
}

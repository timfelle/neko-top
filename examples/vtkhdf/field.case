{
    "version": 1.0,
    "case":
    {
        "mesh_file": "512.nmsh",
        "output_boundary": true,
        "output_checkpoints": true,
        "checkpoint_control": "simulationtime",
        "checkpoint_value": 0.5,
        "restart_file": "fluid00001.chkp",
        "time": {
            "end_time": 1.0,
            "timestep": 1e-2
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 4,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 360.0,
            "initial_condition": {
                "type": "user"
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 0,
                "absolute_tolerance": 1e-7,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "projection_space_size": 20,
                "absolute_tolerance": 1e-4,
                "max_iterations": 800
            },
            "output_control": "simulationtime",
            "output_format": "nek5000",
            "output_value": 0.2
        },
        "simulation_components":
        [
            {
                "type": "curl",
                "fields": [ "u", "v", "w" ],
                "name": "omega",
                "computed_field": "omega",
                "compute_control": "tsteps",
                "compute_value": 50
            }
        ]
    }
}

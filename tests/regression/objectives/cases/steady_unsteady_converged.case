{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "time": {
            // Measured under the current no-slip/paraboloid physics (a
            // separate scratch run of this case, with compare_steady and
            // require_steady_state disabled and end_time extended to
            // 99.9975): the fluid froze (steady simcomp's tol = 1e-6 met)
            // at t ~= 12.7. end_time is set well past that so the objective
            // window below sits inside the converged tail, not to
            // extrapolate to a residual floor. A first attempt with a
            // [49,50] window missed tolerance in the unmasked "mixing
            // whole" objective (2.01e-9 rel. diff vs the 1e-9 tolerance):
            // a t=300 diagnostic run showed [49,50] was still only
            // converged to ~1e-9 between-window drift there, versus
            // ~1e-12 by [99,100]. Landing at t = 100.0 deliberately half
            // a timestep short of a step boundary (see readme.md,
            // "Choosing window boundaries") to avoid the one-extra-step
            // overshoot documented there.
            "end_time": 99.9975,
            "timestep": 0.005
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 3,
            "dealias": false
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 200.0,
            "output_control": "never",
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0,
                    0.0,
                    0.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-09,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-08,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [
                        1
                    ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [
                        2
                    ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [
                        3,
                        4,
                        5,
                        6
                    ]
                }
            ]
        },
        "scalar": {
            "enabled": true,
            "Pe": 1000.0,
            "output_control": "never",
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-12,
                "max_iterations": 200
            },
            "initial_condition": {
                "type": "user",
                "value": 0.0
            },
            "boundary_conditions": [
                {
                    "type": "user_dirichlet",
                    "zone_indices": [
                        1
                    ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [
                        2,
                        3,
                        4,
                        5,
                        6
                    ]
                }
            ]
        },
        "adjoint_fluid": {
            "output_control": "never",
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0,
                    0.0,
                    0.0
                ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [
                        1,
                        3,
                        4,
                        5,
                        6
                    ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [
                        2
                    ]
                }
            ]
        },
        "adjoint_scalar": {
            "enabled": true,
            "initial_condition": {
                "type": "uniform",
                "value": 0.0
            },
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0.0,
                    "zone_indices": [
                        1
                    ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [
                        2,
                        3,
                        4,
                        5,
                        6
                    ]
                }
            ]
        },
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [
                    0.25,
                    0.75
                ],
                "y_bounds": [
                    0.0,
                    1.0
                ],
                "z_bounds": [
                    0.0,
                    1.0
                ]
            },
            {
                "name": "initial_blob",
                "geometry": "box",
                "x_bounds": [
                    0.25,
                    0.5
                ],
                "y_bounds": [
                    0.25,
                    0.5
                ],
                "z_bounds": [
                    0.25,
                    0.75
                ]
            },
            {
                "name": "objective_domain",
                "geometry": "box",
                "x_bounds": [
                    1.5,
                    2.0
                ],
                "y_bounds": [
                    0.0,
                    1.0
                ],
                "z_bounds": [
                    0.0,
                    1.0
                ]
            },
            {
                "name": "inlet_region",
                "geometry": "box",
                "x_bounds": [
                    0.0,
                    0.25
                ],
                "y_bounds": [
                    0.0,
                    1.0
                ],
                "z_bounds": [
                    0.0,
                    1.0
                ]
            }
        ],
        "simulation_components": [
            {
                "type": "steady",
                "tol": 1e-06,
                "compute_control": "tsteps",
                "compute_value": 1,
                "scalar_coupled": false,
                "log_frequency": 25
            }
        ]
    },
    "unsteady": true,
    "checkpoints": {
        "enabled": true,
        "format": "chkp",
        "n_memory": 64
    },
    "optimization": {
        "time_window_test": {
            "compare_steady": true,
            "require_steady_state": true,
            "tolerance": 1e-09
        },
        "design": {
            "type": "brinkman",
            "verbose_design": false,
            "verbose_sensitivity": false,
            "output_format": "fld",
            "mapping": [
                {
                    // f_max*dt = 0.5, matching the other cases here.
                    "type": "RAMP",
                    "f_max": 100.0
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "initial_blob"
            },
            "domain": {
                "type": "point_zone",
                "zone_name": "optimization_domain"
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 0,
            "tolerance": 0.001,
            "mma": {
                "scale": 1.0,
                "xmin": 0.0,
                "xmax": 1.0
            }
        },
        "objectives": [
            {
                "type": "viscous_dissipation",
                "name": "viscous [99,100]",
                "weight": 1.0,
                "start_time": 98.9975
            },
            {
                "type": "brinkman_dissipation",
                "name": "brinkman [99,100]",
                "weight": 1.0,
                "start_time": 98.9975
            },
            {
                "type": "scalar_mixing",
                "name": "mixing whole [99,100]",
                "weight": 1.0,
                "start_time": 98.9975
            },
            {
                "type": "scalar_mixing",
                "name": "mixing down [99,100]",
                "weight": 1.0,
                "start_time": 98.9975,
                "mask_name": "objective_domain"
            },
            {
                "type": "scalar_mixing",
                "name": "mixing inlet [99,100]",
                "weight": 1.0,
                "start_time": 98.9975,
                "mask_name": "inlet_region"
            }
        ]
    }
}

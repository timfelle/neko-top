// Bug #6, E3 (advection-dominated Pe). Parent:
// bug6/passive_scalar__fdstrict.case, changed only case.scalar.Pe
// (20 -> 200) and optimization.fd_test_tolerance. Never edit the parent.
//
// Pe RAISED, never lowered, per the project's own "advection-dominated is
// the target regime" convention (this workspace's memory note of the same
// name) and the plan file's explicit instruction. 200 is scalar_mixing's
// own advection-dominated calibration point (see that case's header:
// "200  4.027e-05  8.826e-02  advection-dominated").
//
// Resolution: UNCHANGED from the parent (polynomial_order 5,
// NEKO_TOP_SENSITIVITY_MESH_N default 8, dt 1.0e-3). No mesh/order bump is
// needed at this Pe -- see the manifest/report for the full cell-Peclet
// and viscous-KIO-number table; in short, cell Pe = Pe * min GLL nodal
// spacing = 200 * 0.0146840 = 2.94, already comfortably under the ~10
// target (compare scalar_mixing's own Pe=200 point, cell Pe 1.807, at a
// finer mesh -- same order of magnitude). Leaving the mesh/order/dt
// untouched also means the fluid side (which the KIO viscous term
// actually depends on, NOT Pe) is bit-for-bit the same known-stable
// configuration passive_scalar already runs today.
//
// fd_test_tolerance -> 1.0e6: unmeasured outcome at this Pe, non-binding
// ceiling, same convention as the other novel variants in this dispatch.
// fd_test_perturbations kept identical to the parent for the same reason
// as the other variants (comparability; NOT independently verified to
// reach FIT at this Pe -- deferred to the measurement dispatch).
{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "time": {
            "end_time": 10.0,
            "timestep": 1.0e-3
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 5,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 1.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-16,
                "max_iterations": 50
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-12,
                "max_iterations": 50
            },
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ],
            "output_control": "never"
        },
        "scalar": {
            "enabled": true,
            // --- changed vs bug6/passive_scalar__fdstrict.case: 20 -> 200 ---
            "Pe": 200.0,
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-18,
                "max_iterations": 50
            },
            "initial_condition": {
                "type": "user"
            },
            "boundary_conditions": [
                {
                    "type": "user_dirichlet",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2 ]
                }
            ]
        },
        "adjoint_scalar": {
            "enabled": true,
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0.0,
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2 ]
                }
            ],
            "initial_condition": {
                "type": "uniform",
                "value": 0.0
            }
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ]
        },
        "simulation_components": [
            {
                "type": "steady",
                "tol": 1e-9,
                "compute_control": "tsteps",
                "compute_value": 1,
                "scalar_coupled": true
            }
        ],
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [ 0.2, 0.8 ],
                "y_bounds": [ 0.2, 0.8 ],
                "z_bounds": [ -1.0, 1.0 ]
            },
            {
                "name": "objective_domain",
                "geometry": "box",
                "x_bounds": [ 0.8, 1.0 ],
                "y_bounds": [ -1.0, 3.0 ],
                "z_bounds": [ -1.0, 3.0 ]
            },
            {
                "name": "initial_ball",
                "geometry": "cylinder",
                "start": [ 0.5, 0.5, -0.5 ],
                "end": [ 0.5, 0.5, 1.5 ],
                "radius": 0.25
            }
        ]
    },
    "optimization": {
        "fd_test_strict": true,
        "fd_test_perturbations": [
            1.0e-1, 1.0e-2, 1.0e-3, 1.0e-4
        ],
        // --- changed vs passive_scalar__fdstrict.case: 5.0e-3 -> 1.0e6 ---
        "fd_test_tolerance": 1.0e6,
        "domain": {
            "type": "point_zone",
            "zone_name": "optimization_domain"
        },
        "design": {
            "type": "brinkman",
            "mapping": [
                {
                    "type": "PDE_filter",
                    "r": 0.05,
                    "tol": 1.0e-20,
                    "max_iter": 600
                },
                {
                    "type": "RAMP",
                    "f_max": 100.0
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "initial_ball"
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 100,
            "tolerance": 1.0e-3,
            "subsolve": "dip",
            "mma": {
                "scale": 1000.0,
                "xmin": 0.0,
                "xmax": 1.0
            }
        },
        "objectives": [
            {
                "type": "scalar_mixing",
                "mask_name": "objective_domain",
                "phi_ref": 0.5,
                "weight": 1.0
            }
        ]
    }
}

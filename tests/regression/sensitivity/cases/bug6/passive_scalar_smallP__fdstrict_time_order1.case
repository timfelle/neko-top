// Bug #6, E2 (time_order probe). Parent:
// bug6/passive_scalar_smallP__fdstrict.case, changed only
// case.numerics.time_order (3 -> 1) and optimization.fd_test_tolerance.
// Never edit the parent.
//
// Rationale (plan file, "2026-09-23/24 -- STATE OF PLAY", "A sharpened
// mechanism hypothesis"): the suspect adjoint term
// (sources/adjoint/adjoint_fluid_pnpn.f90:751-802) is the adjoint
// counterpart of the primal's Karniadakis-Israeli-Orszag high-order
// pressure BC (fluid_pnpn.f90:701, pnpn_res_cpu.f90:80-96), whose EXT
// extrapolation gain is 1, 3, 7 at time_order 1, 2, 3 -- so if the adjoint
// inherits that order-sensitivity, C_hat should move with time_order, not
// just stability.
//
// Which key controls this, established from source (both repos, this
// session):
//   * case.f90:300 reads case.numerics.polynomial_order once for lx; no
//     separate scalar polynomial_order key exists (scalar shares the
//     fluid's c_Xh/space -- src/case.f90:335-347).
//   * case.numerics.time_order is read in exactly one place in Neko,
//     fluid_pnpn.f90:274, and used to build the PRIMAL fluid's
//     time_scheme_controller (`ext_bdf`). The scalar (scalars.f90) does
//     NOT read its own copy -- case.f90:340/347 passes
//     `this%fluid%ext_bdf` (the primal fluid's controller, by reference)
//     into scalar init, so the scalar always runs at whatever order the
//     fluid was built with.
//   * The Neko-TOP adjoint fluid (sources/adjoint/adjoint_fluid_pnpn.f90:
//     306-308) allocates and initialises its OWN, separate
//     `time_scheme_controller_t`, but from the SAME JSON key,
//     'case.numerics.time_order' -- so it tracks the primal's order without
//     sharing the primal's object.
//   * The Neko-TOP adjoint scalar (sources/adjoint/adjoint_case.f90:
//     185-190, 213-222) is initialised with `neko_case%fluid%ext_bdf` --
//     the PRIMAL fluid's controller again (not the adjoint fluid's own),
//     mirroring the primal scalar's sharing pattern.
// Conclusion: a single key, case.numerics.time_order, drives all four
// objects (primal fluid, primal scalar via shared reference, adjoint fluid
// via its own object read from the same key, adjoint scalar via the
// primal's shared reference again). Nothing else needs to change for BOTH
// primal and adjoint to run at the new order.
//
// fd_test_tolerance -> 1.0e6: this is a genuinely new measurement (C_hat at
// time_order 1 is unmeasured), so the tolerance is set to a non-binding
// ceiling (matching the convention already used for this kind of
// unknown-outcome diagnostic on origin/worktree-bug6-confound-experiments'
// scalar_peN.case files) rather than guessed. The run is expected to
// complete and print/CSV-log p_hat/C_hat regardless of where the bias
// lands; the number is what this dispatch exists to produce, not a
// pass/fail gate.
//
// fd_test_perturbations kept identical to the parent
// ([1e-1, 1e-2, 1e-3, 1e-4]) so C_hat is comparable to the fdstrict control
// point-for-point; NOT independently verified to reach FIT at this order
// (no prior measurement exists) -- flagged for the measurement dispatch.
{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "time": {
            "end_time": 10.0,
            "timestep": 1.0e-3
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 2,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 1.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-16,
                "max_iterations": 50
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-12,
                "max_iterations": 50
            },
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ],
            "output_control": "never"
        },
        "scalar": {
            "enabled": true,
            "Pe": 20.0,
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-18,
                "max_iterations": 50
            },
            "initial_condition": {
                "type": "user"
            },
            "boundary_conditions": [
                {
                    "type": "user_dirichlet",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2 ]
                }
            ]
        },
        "adjoint_scalar": {
            "enabled": true,
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0.0,
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2 ]
                }
            ],
            "initial_condition": {
                "type": "uniform",
                "value": 0.0
            }
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ]
        },
        "simulation_components": [
            {
                "type": "steady",
                "tol": 1e-9,
                "compute_control": "tsteps",
                "compute_value": 1,
                "scalar_coupled": true
            }
        ],
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [ 0.2, 0.8 ],
                "y_bounds": [ 0.2, 0.8 ],
                "z_bounds": [ -1.0, 1.0 ]
            },
            {
                "name": "objective_domain",
                "geometry": "box",
                "x_bounds": [ 0.8, 1.0 ],
                "y_bounds": [ -1.0, 3.0 ],
                "z_bounds": [ -1.0, 3.0 ]
            },
            {
                "name": "initial_ball",
                "geometry": "cylinder",
                "start": [ 0.5, 0.5, -0.5 ],
                "end": [ 0.5, 0.5, 1.5 ],
                "radius": 0.25
            }
        ]
    },
    "optimization": {
        "fd_test_strict": true,
        "fd_test_perturbations": [
            1.0e-1, 1.0e-2, 1.0e-3, 1.0e-4
        ],
        // --- changed vs bug6/passive_scalar_smallP__fdstrict.case ---
        "fd_test_tolerance": 1.0e6,
        "domain": {
            "type": "point_zone",
            "zone_name": "optimization_domain"
        },
        "design": {
            "type": "brinkman",
            "mapping": [
                {
                    "type": "PDE_filter",
                    "r": 0.05,
                    "tol": 1.0e-20,
                    "max_iter": 600
                },
                {
                    "type": "RAMP",
                    "f_max": 100.0
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "initial_ball"
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 100,
            "tolerance": 1.0e-3,
            "subsolve": "dip",
            "mma": {
                "scale": 1000.0,
                "xmin": 0.0,
                "xmax": 1.0
            }
        },
        "objectives": [
            {
                "type": "scalar_mixing",
                "mask_name": "objective_domain",
                "phi_ref": 0.5,
                "weight": 1.0
            }
        ]
    }
}

// Bug #6, E2 (dt probe at fixed time_order 3). Parent:
// bug6/passive_scalar_smallP__fdstrict.case, changed only
// case.time.timestep (1.0e-3 -> 5.0e-4, HALVED) and
// optimization.fd_test_tolerance. time_order stays 3 (parent value; this
// is a dt-independence check, not an order probe). Never edit the parent.
//
// Approach reused from ../passive_scalar_smallP_dt2.case (the existing
// dt-doubled sibling of the un-instrumented parent): it varies ONLY
// case.time.timestep, leaving case.time.end_time untouched. Followed here
// with the sign flipped (halved, not doubled), per the task's request.
//
// Rationale: this is a converged-STEADY-state case
// (simulation_components[0].type == "steady", tol 1e-9). For a converged
// steady problem the exact gradient is dt-independent by construction (see
// known-bugs #6 section 6, withdrawn claim 1) -- known-bugs #6 section 7
// already recorded the FD estimate varying only 0.315% across a 16x change
// in dt while the analytic adjoint varied 2.91%, so dt is an established
// axis for localising a bias in this family of bugs (see also this
// project's own memory note "Vary dt to find steady-adjoint bugs").
//
// Cost / end_time implication, established from the case file itself before
// touching anything: the steady simcomp is a TOLERANCE stop, not a
// fixed-step-count one (compute_control "tsteps", compute_value 1, i.e.
// checked every step; halts once its residual < tol). Known-bugs #6
// section 6 records this case's un-instrumented sibling halting at
// t ~ 7.2 regardless of dt (dt is normalised out of the residual --
// energy_norm divides by dt). Halving dt from 1.0e-3 to 5.0e-4 therefore
// keeps the SAME physical halt time (~7.2, well inside end_time 10.0 --
// no end_time change needed) but roughly DOUBLES the number of timesteps,
// and so roughly doubles wall time for this variant relative to
// bug6/passive_scalar_smallP__fdstrict.case (that case's own parent,
// passive_scalar_smallP, costs ~9 minutes per the plan file -- so budget
// roughly 15-20 minutes for this variant's whole 4-point sweep, forward +
// adjoint + 4 perturbed + restore).
//
// fd_test_tolerance -> 1.0e6: unmeasured outcome, non-binding ceiling, same
// convention as the other E2 variants.
{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "time": {
            "end_time": 10.0,
            "timestep": 5.0e-4
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 2,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 1.0,
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-16,
                "max_iterations": 50
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-12,
                "max_iterations": 50
            },
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ],
            "output_control": "never"
        },
        "scalar": {
            "enabled": true,
            "Pe": 20.0,
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-18,
                "max_iterations": 50
            },
            "initial_condition": {
                "type": "user"
            },
            "boundary_conditions": [
                {
                    "type": "user_dirichlet",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2 ]
                }
            ]
        },
        "adjoint_scalar": {
            "enabled": true,
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0.0,
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [ 2 ]
                }
            ],
            "initial_condition": {
                "type": "uniform",
                "value": 0.0
            }
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1 ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [ 2 ]
                }
            ]
        },
        "simulation_components": [
            {
                "type": "steady",
                "tol": 1e-9,
                "compute_control": "tsteps",
                "compute_value": 1,
                "scalar_coupled": true
            }
        ],
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [ 0.2, 0.8 ],
                "y_bounds": [ 0.2, 0.8 ],
                "z_bounds": [ -1.0, 1.0 ]
            },
            {
                "name": "objective_domain",
                "geometry": "box",
                "x_bounds": [ 0.8, 1.0 ],
                "y_bounds": [ -1.0, 3.0 ],
                "z_bounds": [ -1.0, 3.0 ]
            },
            {
                "name": "initial_ball",
                "geometry": "cylinder",
                "start": [ 0.5, 0.5, -0.5 ],
                "end": [ 0.5, 0.5, 1.5 ],
                "radius": 0.25
            }
        ]
    },
    "optimization": {
        "fd_test_strict": true,
        "fd_test_perturbations": [
            1.0e-1, 1.0e-2, 1.0e-3, 1.0e-4
        ],
        // --- changed vs bug6/passive_scalar_smallP__fdstrict.case ---
        "fd_test_tolerance": 1.0e6,
        "domain": {
            "type": "point_zone",
            "zone_name": "optimization_domain"
        },
        "design": {
            "type": "brinkman",
            "mapping": [
                {
                    "type": "PDE_filter",
                    "r": 0.05,
                    "tol": 1.0e-20,
                    "max_iter": 600
                },
                {
                    "type": "RAMP",
                    "f_max": 100.0
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "initial_ball"
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 100,
            "tolerance": 1.0e-3,
            "subsolve": "dip",
            "mma": {
                "scale": 1000.0,
                "xmin": 0.0,
                "xmax": 1.0
            }
        },
        "objectives": [
            {
                "type": "scalar_mixing",
                "mask_name": "objective_domain",
                "phi_ref": 0.5,
                "weight": 1.0
            }
        ]
    }
}

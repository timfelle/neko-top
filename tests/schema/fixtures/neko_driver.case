{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "time": {
            "end_time": 1.0,
            "timestep": 0.001
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 5,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 100.0,
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0,
                    0.0,
                    0.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-06
            },
            "pressure_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 0.0001
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [
                        1
                    ]
                }
            ],
            "output_control": "never"
        }
    }
}

{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": false,
        "time": {
            "end_time": 5.0,
            "timestep": 0.005
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 5,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 2.0,
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0,
                    0.0,
                    0.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 0.0001,
                "max_iterations": 50
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 0.0001,
                "max_iterations": 50
            },
            "boundary_conditions": [
                {
                    "type": "user_velocity",
                    "zone_indices": [
                        1
                    ]
                },
                {
                    "type": "no_slip",
                    "zone_indices": [
                        3,
                        4,
                        5,
                        6
                    ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [
                        2
                    ]
                }
            ],
            "output_control": "never",
            "freeze_flow": false
        },
        "scalar": {
            "enabled": true,
            "Pe": 500.0,
            "solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-06,
                "max_iterations": 50
            },
            "initial_condition": {
                "type": "user"
            },
            "boundary_conditions": [
                {
                    "type": "user_dirichlet",
                    "zone_indices": [
                        1
                    ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [
                        2,
                        3,
                        4,
                        5,
                        6
                    ]
                }
            ]
        },
        "adjoint_scalar": {
            "enabled": true,
            "boundary_conditions": [
                {
                    "type": "dirichlet",
                    "value": 0.0,
                    "zone_indices": [
                        1
                    ]
                },
                {
                    "type": "neumann",
                    "flux": 0.0,
                    "zone_indices": [
                        2,
                        3,
                        4,
                        5,
                        6
                    ]
                }
            ],
            "initial_condition": {
                "type": "uniform",
                "value": 0.0
            }
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0,
                    0.0,
                    0.0
                ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [
                        1,
                        3,
                        4,
                        5,
                        6
                    ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [
                        2
                    ]
                }
            ],
            "freeze_flow": false,
            "output_control": "never"
        },
        "simulation_components": [
            {
                "type": "steady",
                "tol": 1e-07,
                "compute_control": "tsteps",
                "compute_value": 1,
                "log_frequency": 10
            }
        ],
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [
                    1.5,
                    4.5
                ],
                "y_bounds": [
                    -1.0,
                    3.0
                ],
                "z_bounds": [
                    -1.0,
                    3.0
                ]
            },
            {
                "name": "objective_domain",
                "geometry": "box",
                "x_bounds": [
                    5.0,
                    6.0
                ],
                "y_bounds": [
                    -1.0,
                    3.0
                ],
                "z_bounds": [
                    -1.0,
                    3.0
                ]
            }
        ]
    },
    "optimization": {
        "design": {
            "type": "brinkman",
            "mapping": [
                {
                    "type": "PDE_filter",
                    "r": [
                        0.1,
                        0.05
                    ],
                    "r_iterations": 3,
                    "tol": 1e-12,
                    "solver": "cg",
                    "preconditioner": "jacobi"
                },
                {
                    "type": "heaviside_mapping",
                    "eta": 0.5,
                    "beta": [
                        1.0,
                        2.0,
                        4.0
                    ]
                },
                {
                    "type": "RAMP",
                    "f_max": 100.0,
                    "q": 0.1
                }
            ],
            "initial_distribution": {
                "type": "uniform",
                "value": 0.0
            },
            "domain": {
                "type": "point_zone",
                "zone_name": "optimization_domain"
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 100,
            "tolerance": 1e-13,
            "mma": {
                "xmin": 0.0,
                "xmax": 1.0,
                "subsolver": "dip",
                "scale": 1000.0
            },
            "continuation_iterations": 2
        },
        "objectives": [
            {
                "type": "scalar_mixing",
                "mask_name": "objective_domain",
                "weight": 1.0,
                "target_concentration": 0.5,
                "scalar_name": "s"
            },
            {
                "type": "viscous_dissipation",
                "weight": [
                    1.0,
                    2.0
                ],
                "weight_iterations": 2,
                "mask_name": "objective_domain"
            }
        ],
        "constraints": [
            {
                "type": "volume",
                "mask_name": "optimization_domain",
                "limit": 0.05,
                "is_max": false,
                "mapping": [
                    {
                        "type": "linear",
                        "f_max": 1.0
                    }
                ]
            }
        ]
    }
}

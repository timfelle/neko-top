{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": true,
        "time": {
            "end_time": 0.02,
            "timestep": 0.001
        },
        "numerics": {
            "time_order": 1,
            "polynomial_order": 3,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 100.0,
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0,
                    0.0,
                    0.0
                ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-16,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-12,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [
                        1.0,
                        0.0,
                        0.0
                    ],
                    "zone_indices": [
                        1
                    ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [
                        2
                    ]
                }
            ],
            "output_control": "never"
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [
                    0.0,
                    0.0,
                    0.0
                ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [
                        1
                    ]
                },
                {
                    "type": "outflow",
                    "zone_indices": [
                        2
                    ]
                }
            ]
        },
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [
                    0.2,
                    0.8
                ],
                "y_bounds": [
                    0.2,
                    0.8
                ],
                "z_bounds": [
                    -1.0,
                    1.0
                ]
            },
            {
                "name": "initial_ball",
                "geometry": "cylinder",
                "start": [
                    0.5,
                    0.5,
                    -0.5
                ],
                "end": [
                    0.5,
                    0.5,
                    1.5
                ],
                "radius": 0.25
            }
        ]
    },
    "unsteady": true,
    "state_recovery": {
        "type": "checkpoint",
        "n_memory": 20,
        "path": "checkpoints_unsteady_brinkman_dissipation/",
        "algorithm": "linear"
    },
    "optimization": {
        "design": {
            "type": "brinkman",
            "mapping": [
                {
                    "type": "PDE_filter",
                    "r": 0.05,
                    "tol": 1e-25
                },
                {
                    "type": "RAMP",
                    "f_max": 100.0
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "initial_ball"
            },
            "domain": {
                "type": "point_zone",
                "zone_name": "optimization_domain"
            }
        },
        "solver": {
            "type": "steepest_descent",
            "max_iterations": 50,
            "steepest_descent": {
                "xmin": 0.0,
                "xmax": 1.0,
                "step_length": 0.5,
                "move_limit": {
                    "initial": 0.1,
                    "min": 0.001,
                    "max": 0.2,
                    "decrease": 0.7,
                    "increase": 1.1
                }
            }
        },
        "objectives": [
            {
                "type": "brinkman_dissipation",
                "weight": 1.0,
                "dealias_sensitivity": true,
                "dealias_forcing": true
            }
        ]
    }
}

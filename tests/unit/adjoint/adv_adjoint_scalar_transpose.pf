! Verification that the adjoint scalar advection operator really is the
! discrete adjoint of the forward scalar advection operator.
!
! Motivation: known-bugs-backlog item #6 -- the `passive_scalar` sensitivity
! FD check sits on a floor (~2.4e-3 at polynomial_order 5) that is orders of
! magnitude worse than the momentum-based objectives, grows under
! h-refinement, and shrinks under p-refinement. A continuous-adjoint /
! discrete-adjoint mismatch in the scalar advection operator would produce
! exactly that signature, and nothing currently tests the two operators
! against each other.
!
! The identity being tested. For any velocity field u,
!
!   int_Omega  r (u.grad)s  +  int_Omega  grad(r).(u s)  =  oint_dOmega r s (u.n)
!
! since the integrand of the sum is exactly div(r u s). The forward operator
! (`compute_scalar`) discretises the first term; the adjoint operator
! (`compute_adjoint_scalar`) discretises the second -- its own doc comment
! describes it as "in weak form, int grad(r).u s^dagger". So with a velocity
! chosen such that u.n = 0 on every boundary the surface term drops and the
! discrete operators must satisfy
!
!   <forward(a), b>  =  <a, adjoint(b)>
!
! Note the sign: both routines accumulate a *right-hand side* contribution and
! so both already carry the leading minus (the forward does fs -= B (u.grad)s).
! Those two minus signs cancel in the pairing, so the identity is an equality
! rather than the negation the integration-by-parts form might suggest.
!
! Both operators already carry their own mass-matrix weighting internally
! (they accumulate B-weighted contributions into the passed rhs field), so
! the pairing here is a plain dot product, not a B-weighted one.
!
! The velocity used is u = (sin(pi x / 2), 0, 0) on the two-element box
! x in [0, 2], y in [0, 1], z in [0, 1]: u_x vanishes at x = 0 and x = 2, and
! u_y = u_z = 0 everywhere, so u.n = 0 on all six faces. Note that u is NOT
! divergence-free -- it does not need to be, since the identity above holds
! for any u; only the vanishing normal flux matters.
!
! A failure here means the adjoint advection is not the transpose of the
! forward advection, and every scalar-objective gradient is correspondingly
! biased. A pass rules the operator pair out and points the remaining item #6
! error elsewhere.
module adv_adjoint_scalar_transpose
  use mpi
  use pfunit
  use num_types, only: rp
  use mesh, only: mesh_t
  use point, only: point_t
  use space, only: space_t, GLL
  use dofmap, only: dofmap_t
  use gather_scatter, only: gs_t
  use field, only: field_t
  use coefs, only: coef_t
  use math, only: glsc2
  use field_math, only: field_rzero
  use ax_product, only: ax_t, ax_helm_allocator
  use math, only: glsc3
  use time_state, only: time_state_t
  use interpolation, only: interpolator_t
  use scratch_registry, only: scratch_registry_t
  use adjoint_scalar_convection_source_term, only: &
       adjoint_scalar_convection_source_term_t
  use adv_no_dealias, only: adv_no_dealias_t
  use adv_dealias, only: adv_dealias_t
  ! NB: module name does not match its filename
  ! (sources/adjoint/adv_adjoint_dealias.f90 declares `adv_lin_dealias`).
  use adv_lin_dealias, only: adv_lin_dealias_t
  ! NB: module name does not match its filename here
  ! (sources/adjoint/adv_adjoint_no_dealias.f90 declares `adv_lin_no_dealias`).
  use adv_lin_no_dealias, only: adv_lin_no_dealias_t
  use scratch_registry, only: neko_scratch_registry
  use comm, only: NEKO_COMM, pe_rank, pe_size, comm_init
  use neko_config, only: NEKO_BCKND_DEVICE
  use device, only: device_init, device_finalize, device_memcpy, &
       HOST_TO_DEVICE, DEVICE_TO_HOST
  implicit none

  !> Polynomial order of the test space (order 7 => lx = 8).
  integer, parameter :: LX = 8

  !> Dealiased (over-integration) order, the usual 3/2 rule applied to LX.
  integer, parameter :: LXD = (3 * LX) / 2

  !> Relative tolerance on the transpose identity. The two operators are built
  !! from the same GLL quadrature and derivative matrices, so if one is truly
  !! the transpose of the other the identity holds to round-off; this is
  !! deliberately loose enough to absorb accumulation order but far tighter
  !! than any modelling-level discrepancy.
  real(kind=rp), parameter :: transpose_rtol = 1.0e-10_rp

  @TestCase
  type, extends(MPITestCase) :: test_adv_transpose
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_adv_transpose

contains

  subroutine setUp(this)
    class(test_adv_transpose), intent(inout) :: this
    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_init
    end if
    call comm_init
  end subroutine setUp

  subroutine tearDown(this)
    class(test_adv_transpose), intent(inout) :: this
    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_finalize
    end if
  end subroutine tearDown

  !> Build a minimal two-element hex mesh (same fixture as the mapping tests).
  !! Element 1 spans x in [0, 1], element 2 spans x in [1, 2], sharing the
  !! x = 1 face.
  subroutine gen_msh(msh)
    type(mesh_t), intent(inout) :: msh
    type(point_t) :: p(12)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call msh%init(3, 2)
    call msh%add_element(1, 1, p(1), p(2), p(4), p(3), &
         p(7), p(8), p(9), p(10))
    call msh%add_element(2, 2, p(2), p(5), p(6), p(4), &
         p(8), p(11), p(12), p(9))
    call msh%generate_conn()

  end subroutine gen_msh

  !> Build the full SEM coefficient chain and the scratch registry the
  !! advection routines draw temporaries from.
  subroutine build_fixture(msh, Xh, dof, gs, coef)
    type(mesh_t), intent(inout) :: msh
    type(space_t), intent(inout) :: Xh
    type(dofmap_t), intent(inout) :: dof
    type(gs_t), intent(inout) :: gs
    type(coef_t), intent(inout) :: coef

    call gen_msh(msh)
    call Xh%init(GLL, LX, LX, LX)
    call dof%init(msh, Xh)
    call gs%init(dof)
    call coef%init(gs)
    call neko_scratch_registry%init(dof = dof)

  end subroutine build_fixture

  !> Velocity with zero normal component on every boundary face, so the
  !! surface term in the integration-by-parts identity vanishes.
  !! @param u, v, w The velocity components to fill.
  !! @param dof The dofmap supplying nodal coordinates.
  subroutine set_tangential_velocity(u, v, w, dof)
    type(field_t), intent(inout) :: u, v, w
    type(dofmap_t), intent(in) :: dof
    real(kind=rp), parameter :: pi = 4.0_rp * atan(1.0_rp)
    integer :: i, n

    n = dof%size()
    do i = 1, n
       u%x(i,1,1,1) = sin(0.5_rp * pi * dof%x(i,1,1,1))
       v%x(i,1,1,1) = 0.0_rp
       w%x(i,1,1,1) = 0.0_rp
    end do

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(u%x, u%x_d, n, HOST_TO_DEVICE, .true.)
       call device_memcpy(v%x, v%x_d, n, HOST_TO_DEVICE, .true.)
       call device_memcpy(w%x, w%x_d, n, HOST_TO_DEVICE, .true.)
    end if

  end subroutine set_tangential_velocity

  !> Fill a field with a smooth, non-symmetric pattern. Deterministic rather
  !! than random so a failure is reproducible.
  !! @param f The field to fill.
  !! @param dof The dofmap supplying nodal coordinates.
  !! @param phase Shifts the pattern so two calls give independent fields.
  subroutine fill_pattern(f, dof, phase)
    type(field_t), intent(inout) :: f
    type(dofmap_t), intent(in) :: dof
    real(kind=rp), intent(in) :: phase
    integer :: i, n

    n = dof%size()
    do i = 1, n
       f%x(i,1,1,1) = &
            sin(1.7_rp * dof%x(i,1,1,1) + phase) * &
            cos(2.3_rp * dof%y(i,1,1,1) - phase) + &
            0.5_rp * dof%z(i,1,1,1) * dof%x(i,1,1,1)
    end do

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(f%x, f%x_d, n, HOST_TO_DEVICE, .true.)
    end if

  end subroutine fill_pattern

  ! ========================================================================== !

  !> <forward(a), b> = -<a, adjoint(b)> for a boundary-tangential velocity.
  @test(npes=[1])
  subroutine test_adjoint_scalar_advection_is_transpose(this)
    class(test_adv_transpose), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t), target :: coef
    type(adv_no_dealias_t) :: fwd
    type(adv_lin_no_dealias_t) :: adj
    type(field_t) :: u, v, w, a, b, fa, fb
    real(kind=rp) :: lhs, rhs, denom
    integer :: n, ierr

    call MPI_Comm_dup(this%getMpiCommunicator(), NEKO_COMM%mpi_val, ierr)
    pe_rank = this%getProcessRank()
    pe_size = this%getNumProcesses()

    call build_fixture(msh, Xh, dof, gs, coef)
    n = dof%size()

    call fwd%init(coef)
    call adj%init(coef)

    call u%init(dof, 'u')
    call v%init(dof, 'v')
    call w%init(dof, 'w')
    call a%init(dof, 'a')
    call b%init(dof, 'b')
    call fa%init(dof, 'fa')
    call fb%init(dof, 'fb')

    call set_tangential_velocity(u, v, w, dof)
    call fill_pattern(a, dof, 0.0_rp)
    call fill_pattern(b, dof, 1.1_rp)

    ! Both operators accumulate into their rhs argument, so start from zero.
    call field_rzero(fa)
    call field_rzero(fb)

    call fwd%compute_scalar(u, v, w, a, fa, Xh, coef, n)
    call adj%compute_adjoint_scalar(u, v, w, b, fb, Xh, coef, n)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(fa%x, fa%x_d, n, DEVICE_TO_HOST, .true.)
       call device_memcpy(fb%x, fb%x_d, n, DEVICE_TO_HOST, .true.)
    end if

    lhs = glsc2(fa%x, b%x, n)
    rhs = glsc2(a%x, fb%x, n)

    ! Report the raw numbers: if this ever fails, the ratio is far more
    ! informative than the assertion message alone.
    if (pe_rank .eq. 0) then
       write(*, '(A,E20.12)') 'adv transpose: <fwd(a), b>      = ', lhs
       write(*, '(A,E20.12)') 'adv transpose: <a, adj(b)>      = ', rhs
       write(*, '(A,E20.12)') 'adv transpose: diff (want ~0)   = ', lhs - rhs
       denom = max(abs(lhs), abs(rhs))
       if (denom .gt. 0.0_rp) then
          write(*, '(A,E20.12)') 'adv transpose: rel. residual    = ', &
               abs(lhs - rhs) / denom
       end if
    end if

    @assertRelativelyEqual(lhs, rhs, transpose_rtol)

    call u%free()
    call v%free()
    call w%free()
    call a%free()
    call b%free()
    call fa%free()
    call fb%free()
    call coef%free()
    call gs%free()
    call Xh%free()
    call msh%free()
    call neko_scratch_registry%free()

  end subroutine test_adjoint_scalar_advection_is_transpose

  ! ========================================================================== !

  !> The scalar diffusion/Helmholtz operator must be symmetric.
  !!
  !! The adjoint scalar residual reuses Neko's Helmholtz `Ax` exactly as the
  !! forward scalar does (`res%compute(Ax, s_adj, ...)` with h1 = lambda and
  !! h2 = rho_cp * bd / dt). A symmetric operator is its own adjoint, so this
  !! is what makes the diffusion half of the scalar adjoint exact "for free".
  !! Asymmetric handling of h1/h2 would silently bias every scalar-objective
  !! gradient, so it is worth pinning down rather than assuming.
  @test(npes=[1])
  subroutine test_scalar_helmholtz_is_symmetric(this)
    class(test_adv_transpose), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t), target :: coef
    class(ax_t), allocatable :: Ax
    type(field_t) :: a, b, Aa, Ab
    real(kind=rp) :: lhs, rhs, denom
    integer :: n, i, ierr

    call MPI_Comm_dup(this%getMpiCommunicator(), NEKO_COMM%mpi_val, ierr)
    pe_rank = this%getProcessRank()
    pe_size = this%getNumProcesses()

    call build_fixture(msh, Xh, dof, gs, coef)
    n = dof%size()

    call ax_helm_allocator(Ax, type_name = "standard")

    call a%init(dof, 'a')
    call b%init(dof, 'b')
    call Aa%init(dof, 'Aa')
    call Ab%init(dof, 'Ab')

    call fill_pattern(a, dof, 0.0_rp)
    call fill_pattern(b, dof, 1.1_rp)

    ! Representative, non-uniform coefficients: constant h1/h2 would not
    ! exercise a coefficient-ordering bug.
    do i = 1, n
       coef%h1(i,1,1,1) = 0.05_rp + 0.01_rp * dof%x(i,1,1,1)
       coef%h2(i,1,1,1) = 1.0_rp + 0.5_rp * dof%y(i,1,1,1)
    end do
    coef%ifh2 = .true.

    call Ax%compute(Aa%x, a%x, coef, msh, Xh)
    call Ax%compute(Ab%x, b%x, coef, msh, Xh)

    lhs = glsc2(Aa%x, b%x, n)
    rhs = glsc2(a%x, Ab%x, n)

    if (pe_rank .eq. 0) then
       write(*, '(A,E20.12)') 'helm symmetry: <Aa, b>          = ', lhs
       write(*, '(A,E20.12)') 'helm symmetry: <a, Ab>          = ', rhs
       denom = max(abs(lhs), abs(rhs))
       if (denom .gt. 0.0_rp) then
          write(*, '(A,E20.12)') 'helm symmetry: rel. residual    = ', &
               abs(lhs - rhs) / denom
       end if
    end if

    @assertRelativelyEqual(lhs, rhs, transpose_rtol)

    call a%free()
    call b%free()
    call Aa%free()
    call Ab%free()
    call coef%free()
    call gs%free()
    call Xh%free()
    call msh%free()
    call neko_scratch_registry%free()

  end subroutine test_scalar_helmholtz_is_symmetric

  ! ========================================================================== !

  !> The scalar->velocity coupling term must be the transpose of the forward
  !! scalar advection's dependence on velocity.
  !!
  !! This is the term that carries *all* of a scalar objective's design
  !! sensitivity: with it zeroed the analytic sensitivity collapses to ~2e-16
  !! (measured 2026-08-25). The forward scalar equation contains
  !! fs -= B (u.grad)s, whose linearisation in the velocity, in a direction
  !! du, is
  !!
  !!   d(fs) = -B (du.grad)s
  !!
  !! The matching adjoint contribution to the *velocity* equation is the
  !! transpose of that operator applied to s_adj, i.e. -s_adj grad(s), which
  !! is exactly what adjoint_scalar_convection_source_term computes. Duality
  !! then requires
  !!
  !!   <d(fs), s_adj>  ==  <du, B * coupling(s, s_adj)>
  !!
  !! The B on the right is applied here because the source-term *handler*
  !! (source_term_handler_compute) multiplies the accumulated right-hand side
  !! by the mass matrix, while the term itself writes pointwise values.
  !!
  !! Scalar advection is linear in the velocity, so d(fs) is obtained simply
  !! by evaluating the forward operator with du substituted for u -- no
  !! finite differencing, and hence no truncation error to trade against.
  !!
  !! Run with dealias = .false., which exercises the `grad` + `field_subcol3`
  !! branch. That branch uses the element-local (discontinuous) gradient, the
  !! same one the forward `conv1` uses, so it should be an exact transpose.
  @test(npes=[1])
  subroutine test_scalar_velocity_coupling_is_transpose(this)
    class(test_adv_transpose), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t), target :: coef
    type(adv_no_dealias_t) :: fwd
    type(adjoint_scalar_convection_source_term_t) :: coupling
    type(field_t), target :: fu, fv, fw
    type(field_t), pointer :: pfu, pfv, pfw
    type(field_t), target :: s, s_adj
    type(field_t) :: dux, duy, duz, dfs
    type(time_state_t) :: time
    ! Only dereferenced by the dealiased branch, which this test does not use.
    type(interpolator_t), target :: dummy_interp
    type(scratch_registry_t), target :: dummy_scratch
    real(kind=rp) :: lhs, rhs, denom
    integer :: n, ierr

    call MPI_Comm_dup(this%getMpiCommunicator(), NEKO_COMM%mpi_val, ierr)
    pe_rank = this%getProcessRank()
    pe_size = this%getNumProcesses()

    call build_fixture(msh, Xh, dof, gs, coef)
    n = dof%size()

    call fwd%init(coef)

    call s%init(dof, 's')
    call s_adj%init(dof, 's_adj')
    call dux%init(dof, 'dux')
    call duy%init(dof, 'duy')
    call duz%init(dof, 'duz')
    call dfs%init(dof, 'dfs')
    call fu%init(dof, 'fu')
    call fv%init(dof, 'fv')
    call fw%init(dof, 'fw')

    call fill_pattern(s, dof, 0.0_rp)
    call fill_pattern(s_adj, dof, 1.1_rp)
    call fill_pattern(dux, dof, 2.2_rp)
    call fill_pattern(duy, dof, 3.3_rp)
    call fill_pattern(duz, dof, 4.4_rp)

    ! Left-hand side: linearise the forward scalar advection in the velocity
    ! by evaluating it with du in place of u (it is linear in u).
    call field_rzero(dfs)
    call fwd%compute_scalar(dux, duy, duz, s, dfs, Xh, coef, n)

    ! Right-hand side: the adjoint coupling term's contribution.
    call field_rzero(fu)
    call field_rzero(fv)
    call field_rzero(fw)
    pfu => fu
    pfv => fv
    pfw => fw
    call coupling%init_from_components(pfu, pfv, pfw, s, s_adj, coef, &
         coef, dummy_interp, .false., dummy_scratch)
    call time%init(0.0_rp, 1.0_rp, 1.0e-3_rp)
    call coupling%compute(time)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(dfs%x, dfs%x_d, n, DEVICE_TO_HOST, .true.)
       call device_memcpy(fu%x, fu%x_d, n, DEVICE_TO_HOST, .true.)
       call device_memcpy(fv%x, fv%x_d, n, DEVICE_TO_HOST, .true.)
       call device_memcpy(fw%x, fw%x_d, n, DEVICE_TO_HOST, .true.)
    end if

    lhs = glsc2(dfs%x, s_adj%x, n)
    rhs = glsc3(dux%x, coef%B, fu%x, n) &
         + glsc3(duy%x, coef%B, fv%x, n) &
         + glsc3(duz%x, coef%B, fw%x, n)

    if (pe_rank .eq. 0) then
       write(*, '(A,E20.12)') 'coupling: <d(fs), s_adj>        = ', lhs
       write(*, '(A,E20.12)') 'coupling: <du, B*coupling>      = ', rhs
       denom = max(abs(lhs), abs(rhs))
       if (denom .gt. 0.0_rp) then
          write(*, '(A,E20.12)') 'coupling: rel. residual         = ', &
               abs(lhs - rhs) / denom
       end if
    end if

    @assertRelativelyEqual(lhs, rhs, transpose_rtol)

    call coupling%free()
    call s%free()
    call s_adj%free()
    call dux%free()
    call duy%free()
    call duz%free()
    call dfs%free()
    call fu%free()
    call fv%free()
    call fw%free()
    call coef%free()
    call gs%free()
    call Xh%free()
    call msh%free()
    call neko_scratch_registry%free()

  end subroutine test_scalar_velocity_coupling_is_transpose

  ! ========================================================================== !

  !> Same transpose identity as the first test, but for the DEALIASED operator
  !! pair -- which is what the production passive_scalar case actually runs
  !! (numerics.dealias = true).
  !!
  !! This path is structurally very different from the non-dealiased one: the
  !! fields are interpolated up to a GL space of order LXD, the product is
  !! formed there, and the result is mapped back down and assembled with a
  !! gather-scatter followed by a division by the assembled mass matrix. Any
  !! of those steps failing to mirror its forward counterpart would break the
  !! transpose specifically at element interfaces -- which is where the
  !! measured FD-vs-adjoint error is worst (2.4x the interior-dof error, see
  !! known-bugs-backlog item #6).
  !!
  !! Velocity is boundary-tangential for the same reason as before, so the
  !! surface term drops and the identity is exact rather than approximate.
  @test(npes=[1])
  subroutine test_dealiased_adjoint_scalar_advection_is_transpose(this)
    class(test_adv_transpose), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(gs_t) :: gs
    type(coef_t), target :: coef
    type(adv_dealias_t) :: fwd
    type(adv_lin_dealias_t) :: adj
    type(field_t) :: u, v, w, a, b, fa, fb
    real(kind=rp) :: lhs, rhs, denom
    integer :: n, ierr

    call MPI_Comm_dup(this%getMpiCommunicator(), NEKO_COMM%mpi_val, ierr)
    pe_rank = this%getProcessRank()
    pe_size = this%getNumProcesses()

    call build_fixture(msh, Xh, dof, gs, coef)
    n = dof%size()

    call fwd%init(LXD, coef)
    call adj%init(LXD, coef)

    call u%init(dof, 'u')
    call v%init(dof, 'v')
    call w%init(dof, 'w')
    call a%init(dof, 'a')
    call b%init(dof, 'b')
    call fa%init(dof, 'fa')
    call fb%init(dof, 'fb')

    call set_tangential_velocity(u, v, w, dof)
    call fill_pattern(a, dof, 0.0_rp)
    call fill_pattern(b, dof, 1.1_rp)

    call field_rzero(fa)
    call field_rzero(fb)

    call fwd%compute_scalar(u, v, w, a, fa, Xh, coef, n)
    call adj%compute_adjoint_scalar(u, v, w, b, fb, Xh, coef, n)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(fa%x, fa%x_d, n, DEVICE_TO_HOST, .true.)
       call device_memcpy(fb%x, fb%x_d, n, DEVICE_TO_HOST, .true.)
    end if

    lhs = glsc2(fa%x, b%x, n)
    rhs = glsc2(a%x, fb%x, n)

    if (pe_rank .eq. 0) then
       write(*, '(A,E20.12)') 'dealias transpose: <fwd(a), b>  = ', lhs
       write(*, '(A,E20.12)') 'dealias transpose: <a, adj(b)>  = ', rhs
       write(*, '(A,E20.12)') 'dealias transpose: diff         = ', lhs - rhs
       denom = max(abs(lhs), abs(rhs))
       if (denom .gt. 0.0_rp) then
          write(*, '(A,E20.12)') 'dealias transpose: rel. resid.  = ', &
               abs(lhs - rhs) / denom
       end if
    end if

    @assertRelativelyEqual(lhs, rhs, transpose_rtol)

    call u%free()
    call v%free()
    call w%free()
    call a%free()
    call b%free()
    call fa%free()
    call fb%free()
    call coef%free()
    call gs%free()
    call Xh%free()
    call msh%free()
    call neko_scratch_registry%free()

  end subroutine test_dealiased_adjoint_scalar_advection_is_transpose

end module adv_adjoint_scalar_transpose

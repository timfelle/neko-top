!> Unit test: an HDF5 design checkpoint must round-trip exactly when a rank
!! owns no design variables.
!!
!! A rank without design variables still takes part in the collective write
!! and read of the design values, with an empty selection, while the host
!! array of its empty vector is unallocated. A build with runtime checks stops
!! on such an array passed to HDF5, so the checkpoint must hand HDF5 a
!! placeholder buffer instead. The test saves a design with every variable on
!! one of two ranks, loads it into a design holding other values, and
!! requires the loaded values to equal the saved ones exactly, once with each
!! rank empty.
module test_design_checkpoint_hdf5
  use mpi
  use pfunit
  use num_types, only: rp
  use neko, only: neko_init
  use comm, only: NEKO_COMM, pe_rank, MPI_REAL_PRECISION
  use vector, only: vector_t
  use design, only: design_t
  use device, only: HOST_TO_DEVICE, DEVICE_TO_HOST

  implicit none

  !> Design that stores its values, so that a checkpoint can be compared.
  type, extends(design_t) :: stored_design_t
     type(vector_t) :: values
   contains
     procedure, pass(this) :: init => stored_design_init
     procedure, pass(this) :: free => stored_design_free
     procedure, pass(this) :: get_values => stored_design_get_values
     procedure, pass(this) :: update_design => stored_design_update_design
     procedure, pass(this) :: map_forward => stored_design_map_forward
     procedure, pass(this) :: map_backward => stored_design_map_backward
     procedure, pass(this) :: write => stored_design_write
  end type stored_design_t

  @TestCase
  type, extends(MPITestCase) :: test_design_checkpoint_case
   contains
     procedure :: setUp
  end type test_design_checkpoint_case

  logical :: initialized = .false.

  !> Number of design variables, all on one rank.
  integer, parameter :: n_owned = 3

contains

  subroutine setUp(this)
    class(test_design_checkpoint_case), intent(inout) :: this

    if (initialized) return
    initialized = .true.
    call neko_init()

  end subroutine setUp

  ! ========================================================================== !
  ! The tests

  @test(npes=[2])
  subroutine round_trip_second_rank_empty(this)
    class(test_design_checkpoint_case), intent(inout) :: this
    real(kind=rp) :: max_diff

    call round_trip(0, 'design_checkpoint_rank1_empty.h5', max_diff)
    @assertEqual(0.0_rp, max_diff, message = "max |saved - loaded|")

  end subroutine round_trip_second_rank_empty

  @test(npes=[2])
  subroutine round_trip_first_rank_empty(this)
    class(test_design_checkpoint_case), intent(inout) :: this
    real(kind=rp) :: max_diff

    call round_trip(1, 'design_checkpoint_rank0_empty.h5', max_diff)
    @assertEqual(0.0_rp, max_diff, message = "max |saved - loaded|")

  end subroutine round_trip_first_rank_empty

  ! ========================================================================== !
  ! Helpers

  !> Save a design whose variables all sit on one rank, load the checkpoint
  !! into a design holding other values, and compare.
  !! @param owner The rank that owns every design variable.
  !! @param fname The checkpoint file.
  !! @param max_diff The largest difference between the saved and the loaded
  !! values over all ranks.
  subroutine round_trip(owner, fname, max_diff)
    integer, intent(in) :: owner
    character(len=*), intent(in) :: fname
    real(kind=rp), intent(out) :: max_diff
    type(stored_design_t) :: saved, loaded
    real(kind=rp), allocatable :: x_saved(:), x_loaded(:)
    real(kind=rp) :: local_diff
    integer :: n, i, file_unit, ierr
    logical :: file_exists

    n = 0
    if (pe_rank .eq. owner) n = n_owned
    allocate(x_saved(n), x_loaded(n))
    do i = 1, n
       x_saved(i) = 0.25_rp * real(i, kind=rp)
       x_loaded(i) = -1.0_rp
    end do

    ! Start from a fresh file
    inquire(file = fname, exist = file_exists)
    if (file_exists .and. pe_rank .eq. 0) then
       open(newunit = file_unit, file = fname, iostat = ierr)
       close(unit = file_unit, status = 'delete', iostat = ierr)
    end if
    call MPI_Barrier(NEKO_COMM%mpi_val, ierr)

    call saved%init(x_saved)
    call saved%save_checkpoint(fname)

    call loaded%init(x_loaded)
    call loaded%load_checkpoint(fname)

    local_diff = 0.0_rp
    do i = 1, n
       local_diff = max(local_diff, &
            abs(loaded%values%x(i) - saved%values%x(i)))
    end do
    call MPI_Allreduce(local_diff, max_diff, 1, MPI_REAL_PRECISION%mpi_val, &
         MPI_MAX, NEKO_COMM%mpi_val, ierr)

    call saved%free()
    call loaded%free()
    deallocate(x_saved, x_loaded)

  end subroutine round_trip

  ! ========================================================================== !
  ! stored_design_t

  !> Initialise the design with the values given on this rank.
  !! @param x0 The values.
  subroutine stored_design_init(this, x0)
    class(stored_design_t), intent(inout) :: this
    real(kind=rp), intent(in) :: x0(:)

    call this%init_base('stored_design', size(x0))
    this%values = x0

  end subroutine stored_design_init

  subroutine stored_design_free(this)
    class(stored_design_t), intent(inout) :: this

    call this%values%free()
    call this%free_base()

  end subroutine stored_design_free

  !> Copy the stored values into `values`, on the host and the device.
  !! @param values The vector to fill.
  subroutine stored_design_get_values(this, values)
    class(stored_design_t), intent(in) :: this
    type(vector_t), intent(inout) :: values

    if (this%size() .gt. 0) values%x(1:this%size()) = this%values%x(:)
    call values%copy_from(HOST_TO_DEVICE, .true.)

  end subroutine stored_design_get_values

  !> Store `values`, whose device side is current.
  !! @param values The new values.
  subroutine stored_design_update_design(this, values)
    class(stored_design_t), intent(inout) :: this
    type(vector_t), intent(inout) :: values

    if (this%size() .eq. 0) return
    call values%copy_from(DEVICE_TO_HOST, .true.)
    this%values%x(:) = values%x(1:this%size())
    call this%values%copy_from(HOST_TO_DEVICE, .true.)

  end subroutine stored_design_update_design

  subroutine stored_design_map_forward(this)
    class(stored_design_t), intent(inout) :: this
  end subroutine stored_design_map_forward

  subroutine stored_design_map_backward(this, sensitivity)
    class(stored_design_t), intent(inout) :: this
    type(vector_t), intent(in) :: sensitivity
  end subroutine stored_design_map_backward

  subroutine stored_design_write(this, idx)
    class(stored_design_t), intent(inout) :: this
    integer, intent(in) :: idx
  end subroutine stored_design_write

end module test_design_checkpoint_hdf5

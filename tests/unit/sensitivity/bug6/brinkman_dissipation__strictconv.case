// Bug #6, E0b (#57, strict convergence). Parent:
// ../brinkman_dissipation.case. Never edit the parent.
//
// Identical rationale and source citations as
// bug6/viscous_dissipation__strictconv.case (see that file's header): a
// single key, case.fluid.strict_convergence, gates both the primal fluid
// (fluid_scheme_incompressible.f90:312-313, honoured in fluid_aux.f90) and
// the adjoint fluid (adjoint_fluid_scheme_incompressible.f90:364-365, same
// key). This case has no scalar block, so the scalar non-honouring finding
// does not apply here.
//
// max_iterations: already 800 in both solver blocks (the unit tier's own
// value) -- the task's "raise every max_iterations below 800 to 800" step
// therefore changes nothing here; noted rather than silently skipped.
//
// allow_stabilization left at its default (false); see the viscous sibling's
// header for when to reach for it (the #57 census found zero "not converge"
// warnings for this case at max_iterations 800 with strict_convergence
// unset, so an abort here is not expected).
//
// fd_test_strict/perturbations/tolerance are UNCHANGED from the parent.
// Nothing else changed.
{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": true,
        "time": {
            "end_time": 0.1,
            "timestep": 5.0e-3
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 3,
            "dealias": false
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1, 2 ]
                }
            ]
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 0.1,
            // --- changed vs ../brinkman_dissipation.case (new key) ---
            "strict_convergence": true,
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-9,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 1, 2 ]
                }
            ],
            "output_control": "never"
        },
        "simulation_components": [
            {
                "type": "steady",
                "tol": 1e-8,
                "compute_control": "tsteps",
                "compute_value": 1
            }
        ],
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [ 0.2, 0.8 ],
                "y_bounds": [ 0.2, 0.8 ],
                "z_bounds": [ -1.0, 1.0 ]
            },
            {
                "name": "initial_ball",
                "geometry": "cylinder",
                "start": [ 0.5, 0.5, -0.5 ],
                "end": [ 0.5, 0.5, 1.5 ],
                "radius": 0.25
            }
        ]
    },
    "optimization": {
        "fd_test_strict": true,
        "fd_test_tolerance": 4.5e-3,
        "fd_test_perturbations": [
            5.0e-1, 1.0e-1, 5.0e-2, 1.0e-2, 5.0e-3, 1.0e-3, 5.0e-4, 1.0e-4
        ],
        "domain": {
            "type": "point_zone",
            "zone_name": "optimization_domain"
        },
        "design": {
            "type": "brinkman",
            "mapping": [
                {
                    "type": "RAMP",
                    "f_max": 100.0
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "initial_ball"
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 0,
            "tolerance": 1.0e-3,
            "mma": {
                "max_iter": 100,
                "asyinit": 0.5,
                "asyincr": 1.2,
                "asydecr": 0.7,
                "scale": 1.0,
                "auto_scale": false,
                "xmin": 0.0,
                "xmax": 1.0,
                "a0": 1.0,
                "a": 0.0,
                "c": 1000.0,
                "d": 0.0
            }
        },
        "objectives": [
            {
                "type": "brinkman_dissipation",
                "weight": 1.0
            }
        ]
    }
}

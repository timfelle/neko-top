// Bug #6, freeze control (recommended-order step 1 prerequisite). Parent:
// ../viscous_dissipation.case. Never edit the parent.
//
// Purpose: the parent runs exactly 20 steps (end_time 0.1 / timestep 5e-3)
// and never reaches the "steady" simcomp's freeze -- confirmed from the
// baseline handrun log (.claude/scratch/bug6-shared-bias/baseline/handrun/
// neko_viscous_dissipation.log): X-Velocity "Start residual" is still
// 6.08357724E-02 at step 20/20, non-monotonic over steps 1-20 (5.26e-1,
// 3.55e-1, 9.27e-2, ... 1.65e-2, 6.08e-2), never approaching the
// steady_simcomp tol of 1e-8 (case key case.simulation_components[0].tol).
// RESULTS step 1 of the plan file explicitly flags the two unit cases in
// the ~2e-3 C_hat band as "a 20-step truncated transient whose steady
// simcomp never freezes ... not comparable" to the regression-tier
// fluid-only cases, which DO freeze. This variant removes that confound by
// actually reaching the freeze, so the truncated-transient C_hat
// (-2.604826e-3, this session's build) can be compared against a genuinely
// converged one.
//
// Changed vs parent -- exactly two keys, nothing else:
//
//   1. case.time.end_time: 0.1 -> 5.0 (50x). Reasoning (no run performed,
//      per this task's "do not build or run" scope -- flagged to the
//      runner to confirm from steady_state_data.csv):
//        - Case prints Re=0.1, rho=1, mu=10 (mu is the coefficient
//          multiplying diffusion directly, since this case's nondimensio-
//          nalisation puts 1/Re = mu at L=1, U=1). prepare.sh builds the
//          box via `genmeshbox 0 2 0 1 0 z Nx Ny Nz .false. .true. .true.`
//          (N=8 -> Nx=16, Ny=8, matching the log's 128 elements), i.e. a
//          channel of length 2, height 1, periodic in the thin z direction
//          -- so the relevant diffusive time scale is H^2/nu = 1/10 = 0.1,
//          exactly the CURRENT end_time: only one diffusive time has
//          elapsed today, well short of the several time-constants a
//          spectral start-up transient (BDF3/EXT3, impulsive start) needs
//          to decay into the tol=1e-8 band. end_time=5.0 is 50 diffusive
//          times, a large margin.
//        - Cost check from the SAME handrun log: the baseline's 20-step
//          forward-only block took 0.916 s wall (single rank, this box).
//          The full FD sweep for this case is 11 blocks of up to 20 steps
//          each (1 baseline forward-with-adjoint pair, 8 one-sided
//          perturbations, 1 restore-and-reevaluate probe, totalling ~9.9 s
//          for 220 steps at end_time=0.1) -- ~0.045 s/step. At end_time=5.0
//          (1000 steps/block) the same 11-block sweep is estimated at
//          ~0.045 * 1000 * 11 =~ 495 s (~8.3 min), under the ~10 min
//          single-rank budget this task set, with headroom. NOT MEASURED
//          THIS SESSION -- report to the runner as the thing to confirm
//          (and to check steady_state_data.csv for the actual freeze step;
//          case.simulation_components[0].log_frequency is left at its
//          documented default of 50, so with 1000 steps/block there is
//          visibility into the convergence trace even if it never freezes).
//
//   2. optimization.fd_test_tolerance: 5.0e-3 -> 1.0e6. The frozen-fluid
//      C_hat is UNKNOWN a priori (that is the point of this diagnostic --
//      see readme.md "Tolerances of the four unit cases": the parent's
//      5.0e-3 was derived from the parent's OWN measured truncated-
//      transient bias, -2.603e-3, and does not apply to a different
//      (frozen) forward trajectory). 1.0e6 is the same "diagnostic
//      tolerance" convention already used elsewhere in this exact
//      investigation for a control whose C_hat is being measured rather
//      than gated (RESULTS section 3f: "unsteady_viscous_dissipation_Re1.
//      case ... plus a diagnostic fd_test_tolerance of 1e6") -- it lets
//      the strict criterion certify (BOUNDED/FIT) and print p_hat/C_hat
//      without asserting a pass/fail bound nobody can derive yet.
//
// fd_test_strict (already true) and fd_test_perturbations (already the
// pinned historical 8-point sweep) are UNCHANGED, per this task's
// instruction to keep both.
//
// NOT run as part of this dispatch (case-authoring only, per task scope).
{
    "version": 1.0,
    "case": {
        "mesh_file": "box.nmsh",
        "output_checkpoints": false,
        "output_at_end": false,
        "output_boundary": true,
        "time": {
            // --- changed vs ../viscous_dissipation.case ---
            "end_time": 5.0,
            "timestep": 5.0e-3
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 3,
            "dealias": false
        },
        "adjoint_fluid": {
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 1, 2 ]
                }
            ]
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 0.1,
            "initial_condition": {
                "type": "uniform",
                "value": [ 0.0, 0.0, 0.0 ]
            },
            "velocity_solver": {
                "type": "cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "absolute_tolerance": 1e-9,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "hsmg"
                },
                "absolute_tolerance": 1e-8,
                "max_iterations": 800
            },
            "boundary_conditions": [
                {
                    "type": "velocity_value",
                    "value": [ 1.0, 0.0, 0.0 ],
                    "zone_indices": [ 1, 2 ]
                }
            ],
            "output_control": "never"
        },
        "simulation_components": [
            {
                "type": "steady",
                "tol": 1e-8,
                "compute_control": "tsteps",
                "compute_value": 1
            }
        ],
        "point_zones": [
            {
                "name": "optimization_domain",
                "geometry": "box",
                "x_bounds": [ 0.2, 0.8 ],
                "y_bounds": [ 0.2, 0.8 ],
                "z_bounds": [ -1.0, 1.0 ]
            },
            {
                "name": "initial_ball",
                "geometry": "cylinder",
                "start": [ 0.5, 0.5, -0.5 ],
                "end": [ 0.5, 0.5, 1.5 ],
                "radius": 0.25
            }
        ]
    },
    "optimization": {
        "fd_test_strict": true,
        // --- changed vs ../viscous_dissipation.case ---
        "fd_test_tolerance": 1.0e6,
        "fd_test_perturbations": [
            5.0e-1, 1.0e-1, 5.0e-2, 1.0e-2, 5.0e-3, 1.0e-3, 5.0e-4, 1.0e-4
        ],
        "domain": {
            "type": "point_zone",
            "zone_name": "optimization_domain"
        },
        "design": {
            "type": "brinkman",
            "mapping": [
                {
                    "type": "RAMP",
                    "f_max": 100.0
                }
            ],
            "initial_distribution": {
                "type": "point_zone",
                "base_value": 0.0,
                "zone_value": 1.0,
                "zone_name": "initial_ball"
            }
        },
        "solver": {
            "type": "mma",
            "max_iterations": 0,
            "tolerance": 1.0e-3,
            "mma": {
                "max_iter": 100,
                "asyinit": 0.5,
                "asyincr": 1.2,
                "asydecr": 0.7,
                "scale": 1.0,
                "auto_scale": false,
                "xmin": 0.0,
                "xmax": 1.0,
                "a0": 1.0,
                "a": 0.0,
                "c": 1000.0,
                "d": 0.0
            }
        },
        "objectives": [
            {
                "type": "viscous_dissipation",
                "weight": 1.0
            }
        ]
    }
}
